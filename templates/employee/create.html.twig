{% extends 'profile.html.twig' %}

{% block title %} {{ 'action.create' | trans }}  {% endblock %}

{% block content %}


    <div class="my-4">
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                             label="{{ 'employee.employee' | trans }}"
                             isActive="{{ false }}"
        />
        <twig:BreadCrumbItem
                label="{{ 'action.create' | trans }}"
                isActive="true"
        />


        <div class="my-4">
            <div class="mt-2">
                <twig:MainHeader text="{{ 'employee.create_new_employee' | trans }} ">
                </twig:MainHeader>
            </div>
        </div>

        <div class="my-4">
            <div class="max-w-md mx-auto">
            {{ form_start(form) }}

                {{ form_errors(form) }}

                {{ form_row(form.firstName) }}

                {{ form_row(form.lastName) }}

                {{ form_row(form.firstWorkingDay) }}

                {{ form_row(form.lastWorkingDay) }}

                {{ form_row(form.email) }}

                {{ form_row(form.businessNumber) }}

                {{ form_row(form.privateNumber) }}

                {{ form_row(form.streetAndNumber) }}

                {{ form_row(form.city) }}

                {{ form_row(form.postalCode) }}

                {{ form_row(form.monthlySalary) }}

                {{ form_row(form.jobTitle) }}

                <div class="flex justify-between">
                    <div class="flex-shrink w-64">
                        {{ form_row(form.availableVacationDays) }}
                    </div>

                    {{ form_row(form.isHalfDay) }}
                </div>

                <div class="my-4">
                    <twig:Button label="{{ 'action.create' | trans }}" url="{{ false }}" ></twig:Button>
                </div>



            {{ form_end(form) }}
            </div>
        </div>

        <twig:Button url="{{ path('app_employee_index') }}"
                     label="{{ 'action.back' | trans }}"
        >
        </twig:Button>
    </div>
{% endblock %}

<a href="{{ url }}">
    <div style=" word-break:break-all; "
         class=" w-36 h-36 p-4  overflow-ellipsis overflow-hidden flex justify-center items-center   border-2 rounded-lg shadow-sm hover:bg-gray-100   {{ class|default(' ') }} ">

        {% if title %}
            <h2 class="mb-2 text-center font-bold tracking-tight text-gray-900  ">{{ title }}</h2>
        {% else %}
            {% block title %}{% endblock %}
        {% endif %}
    </div>
</a>

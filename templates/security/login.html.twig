{% extends 'base_public.html.twig' %}

{% block title %}{{ 'security.sign_in' | trans }}{% endblock %}

{% block content %}

        <form method="post">
            {% if error %}
                <div class="text-red-500">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <h1 class=" my-4 text-2xl"> {{ 'security.please_sign_in' | trans }}</h1>

            <div class="relative z-0 w-full mb-5 group">
                <input type="email" value="{{ last_username }}" name="_username" id="username"
                       autocomplete="email" autofocus
                       class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:border-gray-600 focus:outline-none focus:ring-0"
                       placeholder=" " required/>
                <label for="username"
                       class="absolute text-sm text-gray-500 dark:text-gray-400  scale-75 -top-2 -z-10 "> {{ 'security.email' | trans }}</label>
            </div>

            <div class="relative z-0 w-full mb-5 group">
                <input type="password" name="_password" id="password" autocomplete="current-password"
                       class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:border-gray-600 focus:outline-none focus:ring-0"
                       placeholder=" " required/>
                <label for="password"
                       class="absolute text-sm text-gray-500 dark:text-gray-400  scale-75 -top-2 -z-10 "> {{ 'security.password' | trans }}</label>
            </div>


            <input type="hidden" name="_csrf_token"
                   value="{{ csrf_token('authenticate') }}"
            >

            {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
            #}

            <twig:Button label="{{ 'security.sign_in' | trans }}" url="{{ false }}"></twig:Button>

        </form>
        <div class="my-4">
            <a href="{{ path('app_forgot_password_request') }}"
               class="text-sm underline underline-offset-4 text-gray-500">{{ 'security.i_do_not_know_the_password' | trans }}</a>
        </div>


{% endblock %}

@startuml
left to right direction
skinparam dpi 300
skinparam ClassAttributeIconSize 0
skinparam ClassPadding 5
skinparam linetype ortho
' === AI Clients ===
package "App.Client.AI" {
    class OpenAIClient
    class OpenAITaskClient
    OpenAITaskClient --|> OpenAIClient
    OpenAIClient ..> Client
}

' === Telegram Clients ===
package "App.Client.Telegram" {
    class TelegramClient
    class TelegramBotClient
    TelegramBotClient --|> TelegramClient
}

' === Controllers ===
package "App.Controller" {
    class BoardController
    class DashboardController
    class FrontendController
    class RegistrationController
    class ResetPasswordController
    class SecurityController
    class SubcategoryController
    class TaskController
    class TelegramWebhookController
}

' === Entities & Enums ===
package "App.Entity" {
    class Task
    class Board
    class User
    class Subcategory
    class ResetPasswordRequest
    enum TaskPriority
    enum TaskStatus
    enum TaskSubstatus
    class TelegramChat
}

' === Symfony & Core Interfaces ===
class Security
class UserPasswordHasherInterface

' === Repositories ===
package "App.Repository" {
    class BoardRepository
    class SubcategoryRepository
    class TaskRepository
    class UserRepository
}

' === Services ===
package "App.Service" {
    class TaskService
    class BotTaskCreationService
    class LocaleSubscriber
    class TwigGlobalBoardsSubscriber
}


' === Controllers use cases ===
BoardController ..> Board
BoardController ..> Subcategory
BoardController ..> BoardRepository
BoardController ..> TaskService
BoardController ..> Security

DashboardController ..> BoardRepository
DashboardController ..> TaskService
DashboardController ..> TaskRepository
DashboardController ..> Security
DashboardController ..> Task
DashboardController ..> TaskStatus

FrontendController ..> BoardRepository

RegistrationController ..> UserPasswordHasherInterface
RegistrationController ..> User

ResetPasswordController ..> User

SubcategoryController ..> SubcategoryRepository
SubcategoryController ..> BoardRepository

TaskController ..> BoardRepository
TaskController ..> TaskService
TaskController ..> TaskRepository
TaskController ..> OpenAITaskClient
TaskController ..> SubcategoryRepository

TelegramWebhookController ..> OpenAITaskClient
TelegramWebhookController ..> UserRepository
TelegramWebhookController ..> TaskService
TelegramWebhookController ..> BotTaskCreationService

' === Domain Relationships ===
Board --> "1" User : belongs to
Board --> "*" Subcategory : contains
Board --> "*" Task : has
User "1" o-- "*" Board : owns
User "*" o-- "*" TelegramChat : has

ResetPasswordRequest --> User : references
Subcategory --> Board
Subcategory --> "0..1" Subcategory : parent
Subcategory --> "*" Subcategory : children
Subcategory --> "*" Task : contains
Task --> Board
Task --> Subcategory
Task --> TaskPriority
Task --> TaskStatus
Task --> TaskSubstatus

' === Services and Subscribers ===
BotTaskCreationService --> OpenAITaskClient
BotTaskCreationService --> Task
BotTaskCreationService --> User


TwigGlobalBoardsSubscriber --> BoardRepository
TwigGlobalBoardsSubscriber --> Security

TaskService --> BoardRepository
TaskService --> TaskRepository
TaskService --> Security
TaskService --> User

@enduml

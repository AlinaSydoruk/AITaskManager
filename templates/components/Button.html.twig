<div class="flex">
    <div class="border-solid border-2 border-gary-100 hover:bg-gray-300 rounded-md px-6 py-2 ">
        {% if url %}
            <a href="{{ url }}"> {{ label }}</a>
        {% else %}
            <button type="submit">
                {{ label }}
            </button>
        {% endif %}
    </div>
</div>
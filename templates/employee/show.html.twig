{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.employee' | trans }}{% endblock %}


{% block content %}

    <div class="my-4">
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                             label="{{ 'employee.employee' | trans }}"
                             isActive="{{ false }}"
        />

        <twig:BreadCrumbItem link="{{ false}}"
                             label="{{ employee.fullName }}"
                             isActive="{{ true }}"
        />



    </div>
    <div class="my-4">
        <div class="mt-2">
            <twig:MainHeader text="{{ employee.fullName }}  ">
                <twig:block name="rightSide">
                    <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">
                        <twig:Button url="{{ path('app_employee_edit' , {"id" : employee.id }) }}"
                                     label="{{ 'action.edit' | trans }}"
                        >
                        </twig:Button>

                        <twig:Button url="{{ path('app_absence_create' , {"employeeId" : employee.id }) }}"
                                     label="{{ 'employee.add_new_absence' | trans }}"
                        >
                        </twig:Button>


                        <twig:Button label="{{ 'action.delete' | trans }}">
                            <twig:block name="attributes"> data-modal-target="popup-modal" data-modal-toggle="popup-modal" </twig:block>
                        </twig:Button>

                        <div id="popup-modal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                            <div class="relative p-4 w-full max-w-md max-h-full">
                                <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
                                    <div class="p-4 md:p-5 text-center">
                                        <svg class="mx-auto mb-4 text-gray-400 w-12 h-12 dark:text-gray-200 p-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                        </svg>
                                        <h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">{{ 'warning.are_you_sure_you_want_to_delete_this_employee' | trans }}</h3>

                                        <div class="flex justify-between px-6 ">
                                            <twig:Button label="{{ 'action.delete' | trans }}"
                                                         url="{{ path('app_employee_delete' ,{"id" : employee.id} ) }}"
                                                         class="text-red-500 p-4 bg-red-100 border-2 border-red-500"

                                            >
                                                <twig:block name="attributes"> data-modal-hide="popup-modal"</twig:block>
                                            </twig:Button>

                                            <twig:Button label="{{ 'action.close' | trans }}">
                                                <twig:block name="attributes"> data-modal-hide="popup-modal"</twig:block>
                                            </twig:Button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </twig:block>
            </twig:MainHeader>
        </div>
        <twig:InformationRow title="{{ 'employee.first_name' | trans }}">
            <twig:block name="value">{{ employee.firstname }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.last_name' | trans }}">
            <twig:block name="value">{{ employee.lastName }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.first_working_day' | trans }}">
            <twig:block name="value">{{ employee.firstWorkingDay |date("d.m.Y") }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.last_working_day' | trans }}">
            <twig:block name="value">{{ employee.lastWorkingDay ? employee.lastWorkingDay |date("d.m.Y") : 'message.not_specified' | trans }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.work_status' | trans }}">
            <twig:block name="value">{{ employee.workStatus.value }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.email' | trans }}">
            <twig:block name="value">{{ employee.email }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.business_number' | trans }}">
            <twig:block name="value">{{ employee.businessNumber }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.private_number' | trans }}">
            <twig:block name="value">{{ employee.privateNumber }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.street_and_number' | trans }}">
            <twig:block name="value">{{ employee.streetAndNumber }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.city' | trans }}">
            <twig:block name="value">{{ employee.city }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.postal_code' | trans }}">
            <twig:block name="value">{{ employee.postalCode }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.monthly_salary' | trans }}">
            <twig:block name="value">{{ employee.monthlySalary|format_currency('CHF') }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.postal_code' | trans }}">
            <twig:block name="value">{{ employee.postalCode }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.job_title' | trans }}">
            <twig:block name="value">{{ employee.jobTitle }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.available_vacations' | trans }}">
            <twig:block name="value">
                {% if availableVacationDays == 0 %}
                    {{ 'employee.you_do_not_have_any_more_vacation_days' | trans }}
                {% else %}
                    {{ availableVacationDays }}
                {% endif %}
            </twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.absence' | trans }}">
            <twig:block name="value">
                {% if employee.absences.get(0) %}
                    {% for absence in employee.absences %}
                        <div class="grid grid-flow-col auto-cols-max text-sm space-y-2">
                            <a href="{{ path('app_absence_show', {"id" : absence.id , "employeeId" : employee.id }) }}" class="underline">
                                {{ absence.startDate |date("d.m.Y") }}
                                {{ 'symbol.dash' | trans }} {{ absence.endDate |date("d.m.Y") }}
                            </a>
                        </div>
                    {% endfor %}
                {% else %}
                    {{ 'absence.you_do_not_have_any_absence' | trans }}
                {% endif %}
            </twig:block>
        </twig:InformationRow>
    </div>

    <div class="my-4">
        <twig:Button url="{{ path('app_employee_index') }}"
                     label="{{ 'action.back' | trans }}">
        </twig:Button>
    </div>

{% endblock content %}








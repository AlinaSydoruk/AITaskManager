{% extends 'base_public.html.twig' %}

{% block title %}{{ 'security.password_reset_email_sent' | trans }}{% endblock %}

{% block content %}
    <div class="my-4">
        {{ 'security.password_reset_email_if_exists' | trans }}
    </div>
    <div class="my-4 font-bold">
            {{ 'security.password_reset_link_expiration' | trans({'expirationTime': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
    </div>
    <div class="my-4">
            {{ 'security.check_spam_if_no_email' | trans }}
            <a href="{{ path('app_forgot_password_request') }}" class="underline">
                {{ 'action.try_again' | trans }}
            </a>
    </div>
{% endblock %}

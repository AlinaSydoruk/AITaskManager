{% block form_row %}
    {% set additional_row_attr =  form.vars.row_attr.class|default('') %}
    {% set additional_attr =  form.vars.attr.class|default('w-full py-2.5 px-3 ') %}
    <div class="{{ form.vars.errors|length > 0 ? 'text-red-500' }} {{ additional_row_attr }}"  >
        {% for error in form.vars.errors %}
            <p class="text-red-500 text-sm mt-2">{{ error.message }}</p>
        {% endfor %}
        {{ form_label(form, form.vars.label, { 'label_attr': { 'class': 'text-sm text-gray-600' } }) }}
        {{ form_widget(form, {
            attr: {
                class: ' text-sm text-gray-900 bg-transparent border-0 border-b-2  focus:outline-none focus:ring-0 ' ~ additional_attr  ~ (form.vars.errors|length > 0 ? '  border-red-500' : ' border-gray-600' ) ,
                placeholder: ' '
            }
        }) }}

    </div>
{% endblock %}

{% block form_errors -%}
    {% if errors|length > 0 -%}
        {% if form is not rootform %}<span>{% else %}<div class="text-red-500 p-4 bg-red-100 border-2 border-red-500 rounded-md">{% endif %}
        <ul class="list-unstyled">
        {%- for error in errors -%}
            <li>{{ error.message }}</li>
        {%- endfor -%}
    </ul>
        {% if form is not rootform %}</span>{% else %}</div>{% endif %}
    {%- endif %}
{%- endblock form_errors %}
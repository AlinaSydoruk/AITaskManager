{% extends 'profile.html.twig' %}

{% block title %}{{ 'task.board' | trans }}{% endblock %}

{% block content %}
    <div class="my-4" data-controller="task">
        <twig:BreadCrumbHome/>
        <div class="my-4">
            <twig:MainHeader text="{{ 'task.board' | trans }}">
                {#<twig:block name="rightSide">
                    <twig:Button url="{{ path('app_task_create') }}"
                                 label="{{ 'action.add_task' | trans }}"
                                 class="w-full"
                    ></twig:Button>
                </twig:block>#}
            </twig:MainHeader>
        </div>

        <div class="grid grid-cols-5 gap-4">
            {% for status in taskStatuses %}
                <div class="bg-gray-100 p-4 rounded-lg shadow-lg">
                    <h2 class="text-lg font-bold">{{ status.value | trans }}</h2>
                    <div class="task-list min-h-32 p-2 bg-white rounded-lg"
                         data-status="{{ status.value }}"
                         data-action="dragover->task#allowDrop drop->task#drop">
                        {% for task in tasks[status.value]?? []  %}

                            <div class="task bg-gray-500 text-black p-2 my-2 rounded-lg cursor-move"
                                 draggable="true"
                                 data-task-id="{{ task.id }}"
                                 data-action="dragstart->task#drag">
                                {{ task.title }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

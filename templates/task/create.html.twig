{% extends 'kanban/base_content.html.twig' %}

{% block title %}{{ 'task.create_new_task' | trans }}{% endblock %}

{% block content %}
    <div class="my-4 ">
        <div class="my-4">
            <div class="mt-2">
                <twig:MainHeader text="{{ 'task.create_new_task' | trans }} ">
                </twig:MainHeader>
            </div>
        </div>

        <div class="my-4">
            <div class="max-w-md mx-auto">

                {{ form_start(form) }}

                {{ form_errors(form) }}

                {{ form_row(form.title) }}

                {{ form_row(form.description) }}

                {{ form_row(form.deadline) }}

                <div class="mt-4">
                    {{ 'task.approximate_estimate' | trans }}
                </div>


                <div class="flex justify-between">
                    <div class="flex-shrink w-64">
                        {{ form_row(form.approximateEstimateDays) }}
                    </div>

                        {{ form_row(form.approximateEstimateHours) }}

                </div>

                {{ form_row(form.scheduledForDate) }}

                {{ form_row(form.taskPriority) }}

                {{ form_row(form.taskStatus) }}


                <div class="my-4">
                    <twig:Button label="{{ 'action.create' | trans }}" url="{{ false }}"></twig:Button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        {% if parentId %}
            <twig:Button url="{{ path('app_subcategory_show' , {'boardId' : boardId, "id" : parentId}) }}" label="{{ 'action.back' | trans }}"></twig:Button>
            {% else %}
                <twig:Button label="{{'action.back' | trans }}" url="{{ path('app_board_index' , {'id': boardId }) }}"></twig:Button>%}
        {% endif %}
    </div>

{% endblock content %}

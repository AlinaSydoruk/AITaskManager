{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.employee' | trans }}{% endblock %}


{% block content %}

    <div class="my-4">
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                             label="{{ 'employee.employee' | trans }}"
                             isActive="{{ false }}"
        />

        <twig:BreadCrumbItem link="{{ false}}"
                             label="{{ 'employee.id' | trans({'id': employee.id }) }}"
                             isActive="{{ true }}"
        />



    </div>
    <div class="my-4">
        <div class="mt-2">
            <twig:MainHeader text="{{ employee.id }}  ,  {{ employee.fullName }}  ">
                <twig:block name="rightSide">
                    <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">
                        <twig:Button url="{{ path('app_employee_edit' , {"id" : employee.id }) }}"
                                     label="{{ 'action.edit' | trans }}"
                        >
                        </twig:Button>

                        <twig:Button url="{{ path('app_absence_create' , {"employeeId" : employee.id }) }}"
                                     label="{{ 'employee.add_new_absence' | trans }}"

                        >
                        </twig:Button>
                    </div>

                </twig:block>
            </twig:MainHeader>
        </div>
        <twig:InformationRow title="{{ 'employee.first_name' | trans }}">
            <twig:block name="value">{{ employee.firstname }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.last_name' | trans }}">
            <twig:block name="value">{{ employee.lastName }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.first_working_day' | trans }}">
            <twig:block name="value">{{ employee.firstWorkingDay |date("m/d/Y") }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.last_working_day' | trans }}">
            <twig:block name="value">{{ employee.lastWorkingDay |date("m/d/Y") }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.work_status' | trans }}">
            <twig:block name="value">{{ employee.workStatus.value }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.email' | trans }}">
            <twig:block name="value">{{ employee.email }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.business_number' | trans }}">
            <twig:block name="value">{{ employee.businessNumber }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.private_number' | trans }}">
            <twig:block name="value">{{ employee.privateNumber }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.street_and_number' | trans }}">
            <twig:block name="value">{{ employee.streetAndNumber }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.city' | trans }}">
            <twig:block name="value">{{ employee.city }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.postal_code' | trans }}">
            <twig:block name="value">{{ employee.postalCode }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.monthly_salary' | trans }}">
            <twig:block name="value">{{ employee.monthlySalary }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.postal_code' | trans }}">
            <twig:block name="value">{{ employee.postalCode }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.job_title' | trans }}">
            <twig:block name="value">{{ employee.jobTitle }}</twig:block>
        </twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.absence' | trans }}">
            <twig:block name="value">
                {% if employee.absences %}
                    {% for absence in employee.absences %}
                        <div class="grid grid-flow-col auto-cols-max text-sm space-y-2">
                            <a href="{{ path('app_absence_show', {"id" : absence.id , "employeeId" : employee.id }) }}">
                                {{ absence.startDate |date("m/d/Y") }}
                                {{ 'symbol.dash' | trans }} {{ absence.endDate |date("m/d/Y") }}
                            </a></div>

                    {% endfor %}
                {% else %}
                    {{ 'absence.you_do_not_have_any_absence' | trans }}
                {% endif %}
            </twig:block>
        </twig:InformationRow>
    </div>

    <div class="my-4">
        <twig:Button url="{{ path('app_employee_index') }}"
                     label="{{ 'action.back' | trans }}">
        </twig:Button>
    </div>

{% endblock content %}








 <nav class="fixed border-gray-200 z-20 px-4 lg:px-6 py-2.5  bg-gray-800 w-full">
        <div class="flex flex-wrap items-center justify-between max-w-screen-xl mx-auto">
            <a href="{{ path("app_home") }}" class="flex items-center">
                <img class="h-8 w-auto" src="{{ asset("images/logo_sandbox.png") }}"  alt="Sandbox">
            </a>
            <div class="flex items-center lg:order-2">

                <button id="dropdownHoverButton" data-dropdown-toggle="dropdownHover" data-dropdown-trigger="hover"
                        class="text-white  hover:bg-gray-700   font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center"
                        type="button">
                    {% for localeOption in app.enabled_locales %}
                        {% if localeOption == app.locale %}
                            <span>{{ ('common.locale_short.' ~ localeOption) | trans }}</span>
                        {% endif %}
                    {% endfor %}
                </button>

                <!-- Dropdown locale -->
                <div id="dropdownHover"
                     class="z-30 hidden bg-gray-800 divide-y divide-gray-500 rounded-lg shadow-sm w-44 ">
                    <ul class="py-2 text-sm " aria-labelledby="dropdownHoverButton">

                        {% for localeOption in app.enabled_locales %}
                            {% if localeOption == app.locale %}
                                {# Skip iteration for the current language #}
                            {% else %}
                                <li>
                                    <a class="block px-4 py-2 hover:bg-gray-600 text-white"
                                       href="{{ path('app_locale_change', {'locale': localeOption}) }}">{{ ('common.locale_short.' ~ localeOption) | trans }}</a>
                                </li>
                            {% endif %}

                            {% if not loop.last %}|{% endif %}
                        {% endfor %}
                    </ul>
                </div>



                <span class="text-2xs text-white px-4">{{ app.user.email }}</span>

                <a href="{{ path('app_logout') }}" class="text-white hover:bg-gray-50 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 mr-2 hover:bg-gray-700 focus:outline-none focus:ring-gray-800">
                    <svg class="w-6 h-6 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 16">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 8h11m0 0L8 4m4 4-4 4m4-11h3a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-3"/>
                    </svg>
                </a>

                <button data-collapse-toggle="mobile-menu-2" type="button" class="inline-flex items-center p-2 ml-1 text-sm  rounded-lg lg:hidden  focus:outline-none focus:ring-2  text-gray-400 hover:bg-gray-700 focus:ring-gray-600" aria-controls="mobile-menu-2" aria-expanded="false">
                    <span class="sr-only">{{ 'profile.open_main_menu' | trans }}</span>
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
                    <svg class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                </button>
            </div>
            <div class="items-center justify-between hidden w-full lg:flex lg:w-auto lg:order-1" id="mobile-menu-2">
                <ul class="flex flex-col mt-4 font-medium lg:flex-row lg:space-x-8 lg:mt-0">

                    <li>
                        <a  href="{{ path('app_home') }}" class="text-white hover:bg-gray-50 font-medium rounded-lg text-md px-4 lg:px-5 py-2 lg:py-2.5 mr-2 hover:bg-gray-700 focus:outline-none focus:ring-gray-800" aria-current="page">{{ 'profile.home' | trans }}</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>
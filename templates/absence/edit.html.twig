{% extends 'base.html.twig' %}

{% block title %}  Absence  {% endblock %}

{% block body %}
    <div>

        <h1>
            {% if isEdit %}
                Update absence
            {% else %}
                Create new absence
            {% endif %}
        </h1>

        {{ form_start(form) }}
        <div class="mb-3">
            <div class="m-2 p-2 bg-gray">
                {{ form_row(form.startDate) }}
            </div>
            <div class="m-2 p-2 bg-gray">
                {{ form_row(form.endDate) }}
            </div>

            <div class="m-2 p-2 bg-gray">
                {{ form_row(form.absenceType) }}
            </div>
            <div class="m-2 p-2 bg-gray">
                {{ form_row(form.comment) }}
            </div>

        </div>
        {% if isEdit %}
            <button type="submit">Save Changes</button>
        {% else %}
             <button type="submit">Create</button>
        {% endif %}

        {{ form_end(form) }}
    </div>
    {% if isEdit %}
        <a href="{{  path('app_absence_show' , {'employeeId' : employeeId , "id" : id })}}"> Back </a>
    {% else %}
        <a href="{{  path('app_employee_show' , {'id' : employeeId })}}"> Back </a>
    {% endif %}

{% endblock %}

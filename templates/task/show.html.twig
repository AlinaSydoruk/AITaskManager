{% extends 'dashboard/base_content.html.twig' %}

{% block title %}{{ 'subcategory.list' | trans }}{% endblock %}

{% block content %}

    <div class="my-4">
        <twig:BreadCrumbHome/>
        {% if boardId %}
            <twig:BreadCrumbItem
                    link="{{ path('app_board_show' , {'id': boardId }) }}"
                    label=" {{ 'board.board' | trans() }} "
                    isActive="{{ false }}"
            />
            {% if task.subcategory %}

                {% if task.subcategory.parent %}
                    {% set parents = subcategory_parent_chain(task.subcategory) %}
                    {% for parent in parents %}
                        <twig:BreadCrumbItem
                                link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : parent.id}) }}"
                                label="{{ parent.title }}"
                                isActive="{{ false }}"
                        />
                    {% endfor %}
                {% endif %}
                <twig:BreadCrumbItem
                        link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : task.subcategory.id}) }}"
                        label="{{ task.subcategory.title }}"
                        isActive="{{ false }}"
                />
            {% endif %}
        {% endif %}

        <twig:BreadCrumbItem link="{{ false }}"
                             label="{{ task.title }} "
                             isActive="{{ true }}"
        />
    </div>


    <div class="my-4">

        <twig:MainHeader text=" {{ task.title }}" description="{{ task.description }}">
            <twig:block name="rightSide">

                <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">
                    <twig:Button label="{{'action.edit' | trans }}" url="{{ path('app_task_edit' , {'boardId': boardId  , 'id' : task.id}) }}"></twig:Button>

                    <twig:Button label="{{'action.delete' | trans }}" url="{{ path('app_task_delete' , {'boardId': boardId , 'id' : task.id}) }}"></twig:Button>
                </div>



            </twig:block>
        </twig:MainHeader>

        <twig:Section title="{{ 'task.details' | trans }}" class="mx-4">
            <twig:block name="content">

                <twig:InformationRow title="{{ 'task.priority' | trans }}">
                    <twig:block name="value">{{ task.taskPriority.getTranslationKey | trans }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.status' | trans }}">
                    <twig:block name="value">{{ task.taskStatus.getTranslationKey | trans }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.deadline' | trans }}">
                    <twig:block name="value">{{ task.deadline ? task.deadline|date('Y-m-d, H:i') : '-' }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.scheduled_for_date' | trans }}">
                    <twig:block name="value">{{ task.scheduledForDate ? task.scheduledForDate|date('Y-m-d, H:i') : '-' }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.estimate' | trans }}">
                    <twig:block name="value">
                        {% set estimate = minutes_to_estimate_parts(task.approximateEstimate) %}

                        {% if estimate[0] > 0 %}{{ estimate[0] }} {{ 'days' | trans }}{% endif %}
                        {% if estimate[1] > 0 or estimate[2] > 0 %}
                            {{ estimate[1] }}h {{ estimate[2] }}min
                        {% endif %}
                        {% if estimate[0] == 0 and estimate[1] == 0 and estimate[2] == 0 %}
                            0 {{ 'estimate.minutes' | trans }}
                        {% endif %}


                    </twig:block>
                </twig:InformationRow>

            </twig:block>
        </twig:Section>


        {% if boardId %}
            {% if subcategory %}
                <twig:Button label="{{ 'action.back' | trans }}"
                             url="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : subcategory.id}) }}"></twig:Button>
            {% else %}
                <twig:Button label="{{ 'action.back' | trans }}"
                             url="{{ path('app_board_show' , {'id': boardId }) }}"></twig:Button>
            {% endif %}
        {% else %}
            <twig:Button label="{{ 'action.back' | trans }}" url="{{ path('app_home') }}"></twig:Button>
        {% endif %}

    </div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}{% endblock %}

{% block body %}
    <div class="h-full w-full bg-[#3A4B53]">
        <div class="max-h-md my-10">
            <div class="max-w-md mx-auto">
                <div class="rounded-lg p-6 bg-gray-100 shadow-xl">
                    <div class="flex justify-center">
                        <img class="h-14 w-auto" src="{{ asset("images/logo_sandbox.png") }}" alt="Sandbox">
                    </div>
                    <div class="px-4">
                     {% block content %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
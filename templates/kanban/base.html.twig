{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.sandbox' | trans }}{% endblock %}

 {% block body %}
     {% include 'partial/_board_header.html.twig' %}



     {% include'partial/_aside.html.twig' %}

     <div class="flex-grow px-6 sm:px-24 md:px-26 lg:px-28 xl:px-32 max-w-screen-xl mx-auto w-full pt-16 ">
         {% for message in app.flashes('success') %}
             <div class="bg-green-100 border border-green-400 text-md text-green-600 p-4 my-2 rounded-lg">{{ message }}</div>
         {% endfor %}
         {% for message in app.flashes('error') %}
             <div class="bg-red-100 border border-red-600 text-md text-red-600 p-4 my-2 rounded-lg">{{ message }}</div>
         {% endfor %}

         {% block content %}{% endblock %}
     </div>
     {% include 'partial/_footer.html.twig' %}
 {% endblock %}
<div class=" border-b-2 {{ hoverEffect ? 'hover:bg-gray-100' : '' }} border-neutral">
    <div class="py-3 pl-4 sm:pl-8 md:pl-16 lg:pl-24 xl:pl-32">
        <div class=" flex text-sm {{ itemsCenter ? 'items-center' : '' }}">
            <div class=" {{ firstColumnWidth ? firstColumnWidth : 'w-1/2' }} px-1">{{ title }} </div>
            <div class="{{ secondColumnWidth ? secondColumnWidth : 'w-1/2' }} px-1">
                {% block value %}
                    <span>
               {{ 'symbol.dash' | trans }}
            </span>
                {% endblock %}
            </div>

        </div>
    </div>
</div>
{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.welcome' | trans }}{% endblock %}

{% block content %}
    <div class="my-4 ">
        <twig:BreadCrumbHome/>
        <div class="my-4">
            <twig:MainHeader text="{{ 'profile.welcome' | trans }}">
                <twig:block name="rightSide">
                    <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">

                    <twig:Button url="{{ path('app_download_employees') }}"
                             label="{{ 'action.download_file' | trans }}"
                             class="w-full"
                ></twig:Button>
                <twig:Button url="{{ path('app_upload_absences') }}"
                             label="{{ 'action.upload_file' | trans }}"
                             class="w-full"
                ></twig:Button>
                    </div>
                </twig:block>
            </twig:MainHeader>
        </div>
        <a href="{{ path('app_employee_index') }}">
            <div class=" border-y-2 hover:bg-gray-200  border-neutral">
                <div class="py-3 pl-4 sm:pl-8 md:pl-16 lg:pl-24 xl:pl-32">
                    {{ 'profile.employee' | trans }}
                </div>
            </div>
        </a>
    </div>

{% endblock content %}

{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.welcome' | trans }}{% endblock %}

{% block content %}
    <div class="my-4 ">
        <twig:BreadCrumbHome/>
        <div class="my-4">
            <twig:MainHeader text="{{ 'profile.welcome' | trans }}">
                <twig:block name="rightSide">
                    <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">


                    </div>
                </twig:block>
            </twig:MainHeader>
        </div>


        <div class="my-4">
            <div class="max-w-md mx-auto">

                {% if boards %}
                    <div class="flex flex-wrap gap-4 ">
                        {% for board in boards %}
                            <twig:BoardCard color="{{ board.color }}" title="{{ board.title }}"
                                            url="{{ path("app_board_index", { "id" : board.id } ) }}"></twig:BoardCard>
                        {% endfor %}
                        <twig:BoardCard color="gray-300"
                                        url="{{ path("app_board_create") }}">
                            <twig:block name="title">
                                <svg width="42" height="42" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21 13V29M13 21H29M41 21C41 32.0457 32.0457 41 21 41C9.9543 41 1 32.0457 1 21C1 9.9543 9.9543 1 21 1C32.0457 1 41 9.9543 41 21Z" stroke="#1E1E1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>

                            </twig:block>
                        </twig:BoardCard>
                    </div>
                {% else %}
                    <div class="m-4 p-4">
                        <h1> {{ 'welcome.no_boards' | trans }} </h1>

                        <twig:BoardCard color="gray-300"
                                        url="{{ path("app_board_create") }}">
                            <twig:block name="title">
                                <svg width="42" height="42" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21 13V29M13 21H29M41 21C41 32.0457 32.0457 41 21 41C9.9543 41 1 32.0457 1 21C1 9.9543 9.9543 1 21 1C32.0457 1 41 9.9543 41 21Z" stroke="#1E1E1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </twig:block>
                        </twig:BoardCard>

                    </div>

                {% endif %}

            </div>
        </div>


    </div>

{% endblock content %}

<div class="flex">
    {% if url %}
        <a href="{{ url }}"
           class="text-center border-solid border-2 border-gray-200 hover:bg-gray-300 rounded-md px-6 py-2 {{ class|default(' ') }} "> {{ label }}</a>
    {% else %}
        <button type="submit"
                class="text-center border-solid border-2 border-gray-200 hover:bg-gray-300 rounded-md px-6 py-2 ">
            {{ label }}
        </button>
    {% endif %}
</div>

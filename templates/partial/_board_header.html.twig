            <div class="items-center justify-between hidden w-full lg:flex lg:w-auto lg:order-1" id="mobile-menu-2">
                <ul class="flex flex-col mt-4 font-medium lg:flex-row lg:space-x-8 lg:mt-0">

                    <li>
                        <a  href="{{ path('app_home') }}" class="text-white hover:bg-gray-50 font-medium rounded-lg text-md px-4 lg:px-5 py-2 lg:py-2.5 mr-2 hover:bg-gray-700 focus:outline-none focus:ring-gray-800" aria-current="page">{{ 'profile.home' | trans }}</a>
                    </li>

                    <li>
                        <a href="#" class="text-white hover:bg-gray-50 font-medium rounded-lg text-md px-4 lg:px-5 py-2 lg:py-2.5 mr-2 hover:bg-gray-700 focus:outline-none focus:ring-gray-800" aria-current="page" type="button" data-drawer-target="drawer-example" data-drawer-show="drawer-example" aria-controls="drawer-example">
                           {{ 'boards.boards' | trans }}
                        </a>

                    </li>

                    <li>
                    <li>
                        <a  href="{{ path('app_task_create') }}" class="text-white hover:bg-gray-50 font-medium rounded-lg text-md px-4 lg:px-5 py-2 lg:py-2.5 mr-2 hover:bg-gray-700 focus:outline-none focus:ring-gray-800" aria-current="page">{{ 'profile.new_task' | trans }}</a>

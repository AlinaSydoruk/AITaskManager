{% extends 'base.html.twig' %}

{% block title %}Employees{% endblock %}

{% block body %}
   <div>
       <h1>
           Employees
       </h1>

       {% for employee in pagerfanta %}
           <div class="m-2 bg-gray">
               <a href="{{ path("app_employee_show" , {'id' : employee.id}) }}">
                   <div class="mb-3">
                       {{ employee.firstname }}  {{ employee.lastName }}, {{ employee.email }}
                   </div>
               </a>
               <a href="{{ path('app_employee_delete' ,{"id" : employee.id} ) }}"> Delete </a>
           </div>
       {% endfor %}
       {{ pagerfanta(pagerfanta) }}

       <a href="{{ path('app_employee_create') }}"> Create new Employee</a>
       <a href="{{ path('app_download_employees') }}">Download File</a>

       <div>
           {{ form_start (uploadForm, {'action': path('app_upload_absences' )} )  }}
           {{ form_errors(uploadForm) }}
           {{ form_row(uploadForm.uploadFile)}}
           <button type="submit">Upload Absences</button>
           {{ form_end(uploadForm) }}
       </div>
   </div>
{% endblock %}

{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.welcome' | trans }}{% endblock %}

{% block content %}
    <div class="flex flex-col space-y-5 ">
        <div class="mt-2">
            <twig:MainHeader text="{{ 'profile.welcome' | trans }}"></twig:MainHeader>

            <div class="my-3 ">
                {{ 'welcome.you_are_logged_in_as' | trans }} {{ app.user.userIdentifier }}
            </div>

        </div>
        <a href="{{ path('app_employee_index') }}">
            <div class=" border-y-2 hover:bg-gray-200  border-neutral">
                <div class="py-3 pl-4 sm:pl-8 md:pl-16 lg:pl-24 xl:pl-32">
                    {{ 'profile.employees' | trans }}
                </div>
            </div>
        </a>
    </div>

{% endblock content %}

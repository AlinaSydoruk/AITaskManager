{% extends 'profile.html.twig' %}

{% block title %} {{ 'action.edit' | trans }}  {% endblock %}

{% block content %}


    <div class="my-4">
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                             label="{{ 'employee.employee' | trans }}"
                             isActive="{{ false }}"
        />
        <twig:BreadCrumbItem
                label="{{ 'action.edit' | trans }}"
                isActive="true"
        />

        <div class="my-4">
            <div class="mt-2">
                <twig:MainHeader text="{{ 'action.edit' | trans }} ">
                </twig:MainHeader>
            </div>
        </div>

        <div class="my-4">
            <div class="max-w-md mx-auto">

                {{ form_start(form) }}

                {{ form_errors(form) }}

                {{ form_row(form.firstName) }}

                {{ form_row(form.lastName) }}

                {{ form_row(form.firstWorkingDay) }}

                {{ form_row(form.lastWorkingDay) }}

                {{ form_row(form.workStatus) }}

                {{ form_row(form.email) }}

                {{ form_row(form.businessNumber) }}

                {{ form_row(form.privateNumber) }}

                {{ form_row(form.streetAndNumber) }}

                {{ form_row(form.city) }}

                {{ form_row(form.postalCode) }}

                {{ form_row(form.monthlySalary) }}

                {{ form_row(form.jobTitle) }}

                <div class="my-4">
                    <twig:Button label="{{ 'action.save_changes' | trans }}" url="{{ false }}"></twig:Button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <twig:Button url="{{ path('app_employee_show' , {"id" : id }) }}"
                     label="{{ 'action.back' | trans }}">
        </twig:Button>
    </div>

{% endblock %}

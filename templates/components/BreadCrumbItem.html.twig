<div class="inline-flex">
    {% if isActive %}
        <div class="text-gray-600 flex items-center my-2">
            <svg class="w-4 h-4 text-gray-800 " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 8 14">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 13 5.7-5.326a.909.909 0 0 0 0-1.348L1 1"/>
            </svg>
            <div class="mb-1">
                {{ label }}
            </div>
        </div>
    {% else %}
        <a href="{{ link }}">
            <div class="text-gray-600 flex items-center gap-1 hover:gap-3 transition-all duration-300 my-2">
                <svg class="w-4 h-4 text-gray-800 " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 8 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 13 5.7-5.326a.909.909 0 0 0 0-1.348L1 1"/>
                </svg>
                <div class="mb-1">
                    {{ label }}
                </div>
            </div>
        </a>
    {% endif %}
</div>

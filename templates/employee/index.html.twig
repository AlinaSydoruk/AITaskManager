{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.employee' | trans  }}{% endblock %}


{% block content %}

<div class="my-4">
    <twig:BreadCrumbHome/>
    <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                         label="{{ 'employee.employee' | trans }}"
                         isActive="true"
    />


    <div class="my-4">
        <div class="mt-2">
            <twig:MainHeader text="{{ 'employee.employee' | trans }} ">
                <twig:block name="rightSide">
                            <twig:Button url="{{ path('app_employee_create') }}"
                                         label="{{ 'employee.create_new_employee' | trans }}"
                                         class="w-full"
                            ></twig:Button>
                </twig:block>
            </twig:MainHeader>
        </div>
    </div>
    <div class="my-4 ">
       {% for employee in pagerfanta %}

           <div class=" border-b-2 hover:bg-gray-100  border-neutral">
               <a href="{{ path("app_employee_show" , {'id' : employee.id}) }}">
                   <div class=" px-4 py-4 md:px-8 lg:px-12 xl:px-16">
                       <div class=" flex items-center  text-sm">
                           <div class="flex-1 ">
                               {{ employee.fullName }} , {{ employee.email }}
                           </div>
                       </div>
                   </div>
               </a>
           </div>


       {% endfor %}
    </div>
       {{ pagerfanta(pagerfanta) }}


    <div class="my-4">
        <twig:Button url="{{ path('app_home') }}" label="{{ 'action.back' | trans }}"></twig:Button>
    </div>

   </div>
{% endblock %}

{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.employee' | trans  }}{% endblock %}


{% block content %}
    <div class=" ">
        <div class="mt-2">
            <twig:MainHeader text="{{ employee.id}}  ,   {{ employee.firstname }}"></twig:MainHeader>
        </div>

        <twig:InformationRow title="{{ 'employee.first_name' | trans  }}" information="{{ employee.firstname }}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.last_name' | trans  }}" information="{{ employee.lastName }}"></twig:InformationRow>

        <twig:InformationRow title="{{ 'employee.first_working_day' | trans  }}" information="{{ employee.firstWorkingDay |date("m/d/Y") }}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.last_working_day' | trans  }}" information="{{ employee.lastWorkingDay |date("m/d/Y") }}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.work_status' | trans  }}" information="{{ employee.workStatus.value }}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.email' | trans  }}" information="{{ employee.email }}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.business_number' | trans  }}" information="{{ employee.businessNumber }}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.private_number' | trans  }}" information="{{employee.privateNumber}}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.street_and_number' | trans  }}" information="{{employee.streetAndNumber}}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.city' | trans  }}" information="{{employee.city}}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.postal_code' | trans  }}" information="{{ employee.postalCode}}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.monthly_salary' | trans  }}" information="{{ employee.monthlySalary}}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.postal_code' | trans  }}" information="{{ employee.postalCode}}"></twig:InformationRow>
        <twig:InformationRow title="{{ 'employee.job_title' | trans  }}" information="{{ employee.jobTitle}}"></twig:InformationRow>


        <twig:InformationRow title="{{ 'employee.absence' | trans  }}" >
            {% if employee.absences %}
            <twig:block name="value">
                {% for absence in employee.absences %}
                    <div class="grid grid-flow-col auto-cols-max text-sm space-y-2">
                        <a href="{{ path('app_absence_show', {"id" : absence.id , "employeeId" : employee.id }) }}">
                            {{ absence.startDate |date("m/d/Y") }}
                            {{ 'symbol.dash' | trans }} {{ absence.endDate |date("m/d/Y") }}
                        </a></div>

                {% endfor %}
            </twig:block>
            {% else %}
                {{ 'absence.you_do_not_have_any_absence' | trans }}
            {% endif %}
        </twig:InformationRow>

    </div>

{% endblock content %}


               Absence :
               {% if employee.absences %}


    <a href="{{ path('app_employee_index') }}"> Back </a>
    <br>
    <a href="{{ path('app_employee_edit' , {"id" : employee.id }) }}"> Edit </a>
    <br>
    <a href="{{ path('app_absence_create' , {"employeeId" : employee.id }) }}"> Add new absence</a>






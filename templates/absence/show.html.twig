{% extends 'profile.html.twig' %}

{% block title %}{{ 'employee.absence' | trans }}{% endblock %}

{% block content %}

<div class="my-4">
    <twig:BreadCrumbHome/>
    <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                         label="{{ 'employee.employee' | trans }}"
                         isActive="{{ false }}"
    />
    <twig:BreadCrumbItem link="{{ path('app_employee_show' , {'id' : employeeId }) }}"
                         label="{{ employeeFullName }}"
                         isActive="{{ false }}"
    />
    <twig:BreadCrumbItem link="{{ false }}"
                         label="{{ 'employee.absence' | trans }}"
                         isActive="true"
    />

</div>

<div class="my-4">
    <div class="mt-2">
        <twig:MainHeader text=" {{ 'absence.absence_id_start_date_end_date' | trans( {'id' : absence.id , 'startDate' :  absence.startDate |date("d.m.Y")   , 'endDate' : absence.endDate |date("d.m.Y")   })}}">
            <twig:block name="rightSide">
                <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">
                    <twig:Button url="{{  path('app_absence_edit' , {"employeeId" : employeeId , "id" : absence.id }) }}"
                                 label="{{ 'action.edit' | trans }}">
                    </twig:Button>

                    <twig:Button label="{{ 'action.delete' | trans }}">
                        <twig:block name="attributes"> data-modal-target="popup-modal" data-modal-toggle="popup-modal" </twig:block>
                    </twig:Button>

                    <div id="popup-modal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                        <div class="relative p-4 w-full max-w-md max-h-full">
                            <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
                                <div class="p-4 md:p-5 text-center">
                                    <svg class="mx-auto mb-4 text-gray-400 w-12 h-12 dark:text-gray-200 p-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                    </svg>
                                    <h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">{{ 'warning.are_you_sure_you_want_to_delete_this_absence' | trans }}</h3>

                                    <div class="flex justify-between px-6 ">
                                        <twig:Button label="{{ 'action.delete' | trans }}"
                                                     url="{{  path('app_absence_delete' , {"employeeId" : employeeId , "id" : absence.id }) }}"
                                                     class="text-red-500 p-4 bg-red-100 border-2 border-red-500">
                                            <twig:block name="attributes"> data-modal-hide="popup-modal"</twig:block>
                                        </twig:Button>

                                        <twig:Button label="{{ 'action.close' | trans }}" >
                                            <twig:block name="attributes"> data-modal-hide="popup-modal"</twig:block>
                                        </twig:Button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </twig:block>
        </twig:MainHeader>
    </div>


    <twig:InformationRow title="{{ 'absence.start_date' | trans }}">
        <twig:block name="value">{{ absence.startDate |date("d.m.Y") }}  {{ absence.isStartDateHalfDay ? 'absence.midday' | trans : '' }} </twig:block>
    </twig:InformationRow>

    <twig:InformationRow title="{{ 'absence.end_date' | trans }}">
        <twig:block name="value">{{ absence.endDate |date("d.m.Y") }}  {{ absence.isEndDateHalfDay ? 'absence.midday' | trans : '' }} </twig:block>
    </twig:InformationRow>

    <twig:InformationRow title="{{ 'absence.absence_type' | trans }}">
        <twig:block name="value">{{  absence.absenceType.value }}</twig:block>
    </twig:InformationRow>

    <twig:InformationRow title="{{ 'absence.comment' | trans }}">
        <twig:block name="value">{{ absence.comment}}</twig:block>
    </twig:InformationRow>

</div>
    <twig:Button url="{{ path('app_employee_show' , {"id" : employeeId }) }}"
                 label="{{ 'action.back' | trans }}"
    >
    </twig:Button>


{% endblock %}

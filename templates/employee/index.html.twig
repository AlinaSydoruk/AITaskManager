{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.employee' | trans  }}{% endblock %}


{% block content %}

<div class="my-4">
    <twig:BreadCrumbHome/>
    <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                         label="{{ 'employee.employee' | trans }}"
                         isActive="true"
    />


    <div class="my-4">
        <div class="mt-2">
            <twig:MainHeader text="{{ 'employee.employee' | trans }} ">
                <twig:block name="rightSide">
                    <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">


                    </div>


                    <button data-popover-target="popover-left" data-popover-placement="left" type="button"  class=" border-solid border-2 border-gray-200  rounded-md px-6 pb-4  ">
                        <span class="text-2xl text-gray-900 ">...</span>
                    </button>
                    <div data-popover id="popover-left" role="tooltip" class="absolute z-10 invisible inline-block w-64 text-sm  transition-opacity duration-300 bg-gray-50 border border-gray-200 rounded-lg shadow-sm opacity-0  p-2">

                        <div class="space-y-2">
                            <twig:Button url="{{ path('app_employee_create') }}"
                                         label="{{ 'employee.create_new_employee' | trans }}"
                                         class="w-full"
                            ></twig:Button>
                            <twig:Button url="{{ path('app_download_employees') }}"
                                         label="{{ 'action.download_file' | trans }}"
                                         class="w-full"
                            ></twig:Button>
                            <twig:Button url="{{ path('app_upload_absences') }}"
                                         label="{{ 'action.upload_file' | trans }}"
                                         class="w-full"
                            ></twig:Button>
                        </div>


                    </div>




                </twig:block>
            </twig:MainHeader>
        </div>
    </div>
       {% for employee in pagerfanta %}

           <div class=" border-b-2 hover:bg-gray-100  border-neutral">
               <div class=" px-4 py-4 md:px-8 lg:px-12 xl:px-16">
                   <div class=" flex items-center  text-sm" >
                       <div class="flex-1 " >
                           <a href="{{ path("app_employee_show" , {'id' : employee.id}) }}">
                                   {{ employee.fullName }} , {{ employee.email }}
                           </a>
                       </div>
                       <div class="flex-2">
                           <twig:Button label="{{ 'action.delete' | trans }}" url="{{ path('app_employee_delete' ,{"id" : employee.id} ) }}"></twig:Button>
                       </div>
                   </div>
               </div>
           </div>


       {% endfor %}
       {{ pagerfanta(pagerfanta) }}


    <div class="my-4">
        <twig:Button url="{{ path('app_home') }}" label="{{ 'action.back' | trans }}"></twig:Button>
    </div>

   </div>
{% endblock %}

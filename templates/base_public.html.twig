{% extends 'base.html.twig' %}
{% block title %}{% endblock %}

{% block body %}
    <div class="h-screen w-full bg-[#3A4B53] flex justify-center items-center">
        <div class="max-w-md w-full">
            <div class="rounded-lg p-6 bg-gray-100 shadow-xl">
                <div class="flex justify-center">
                    <img class="h-14 w-auto" src="{{ asset('images/logo_sandbox.png') }}" alt="Sandbox">
                </div>
                <div class="px-4">
                    {% block content %}{% endblock %}
                </div>
            </div>
        </div>
    </div>


{% endblock %}
{% extends 'dashboard/base_content.html.twig' %}

{% block title %}{{ 'task.create_new_task' | trans }}{% endblock %}

{% block content %}
    <div class="my-4 ">

        <twig:BreadCrumbHome/>
        {% if boardId %}
            <twig:BreadCrumbItem
                    link="{{ path('app_board_show' , {'id': boardId }) }}"
                    label=" {{ 'board.board' | trans() }} "
                    isActive="{{ false }}"
            />


            {% if subcategory.parent %}
                {% set parents = subcategory_parent_chain(subcategory) %}
                {% for parent in parents %}
                    <twig:BreadCrumbItem
                            link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : parent.id}) }}"
                            label="{{ parent.title }}"
                            isActive="{{ false }}"
                    />
                {% endfor %}
            {% endif %}
            <twig:BreadCrumbItem
                    link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : subcategory.id}) }}"
                    label="{{ subcategory.title }}"
                    isActive="{{ false }}"
            />
        {% endif %}

        <twig:BreadCrumbItem link="{{ false }}"
                             label="{{ "action.create" | trans }}"
                             isActive="{{ true }}"
        />


        <div class="my-4">
            <div class="mt-2">
                <twig:MainHeader text="{{ 'task.create_new_task' | trans }} ">
                </twig:MainHeader>
            </div>
        </div>

        <div class="my-4">
            <div class="max-w-md mx-auto">

                {{ form_start(form) }}

                {{ form_errors(form) }}

                {{ form_row(form.title) }}

                {{ form_row(form.description) }}


                <div class="flex justify-between">
                    <div class="flex-shrink w-64">
                        {{ form_row(form.deadline_date) }}
                    </div>
                    {{ form_row(form.deadline_time) }}
                </div>

                <div class="mt-4">
                    {{ 'task.approximate_estimate' | trans }}
                </div>


                <div class="flex justify-between">
                    <div class="flex-shrink w-64">
                        {{ form_row(form.estimate.days) }}
                    </div>

                    {{ form_row(form.estimate.time) }}

                </div>

                <div class="flex justify-between">
                    <div class="flex-shrink w-64">
                        {{ form_row(form.scheduled_date) }}
                    </div>
                    {{ form_row(form.scheduled_time) }}
                </div>

                {{ form_row(form.taskPriority) }}

                {{ form_row(form.taskStatus) }}


                <div class="my-4">
                    <twig:Button label="{{ 'action.create' | trans }}" url="{{ false }}"></twig:Button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        {% if boardId %}
            {% if parentId %}
                <twig:Button url="{{ path('app_subcategory_show' , {'boardId' : boardId, "id" : parentId}) }}"
                             label="{{ 'action.back' | trans }}"></twig:Button>
            {% else %}
                <twig:Button label="{{ 'action.back' | trans }}"
                             url="{{ path('app_board_show' , {'id': boardId }) }}"></twig:Button>%}
            {% endif %}

        {% else %}
            <twig:Button url="{{ path('app_home') }}" label="{{ 'action.back' | trans }}"></twig:Button>
        {% endif %}
    </div>

{% endblock content %}

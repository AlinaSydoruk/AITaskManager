{% extends 'profile.html.twig' %}

{% block title %}{{ 'profile.employee' | trans }}{% endblock %}
{% block content %}

    <div class="my-4">
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem link="{{ path('app_employee_index') }}"
                             label="{{ 'employee.employee' | trans }}"
                             isActive="true"
        />
        <div class="my-4">
            <div class="mt-2">
                <twig:MainHeader text="{{ 'employee.employee' | trans }} ">
                    <twig:block name="rightSide">
                        <twig:Button url="{{ path('app_employee_create') }}"
                                     label="{{ 'employee.create_new_employee' | trans }}"
                                     class="w-full"
                        ></twig:Button>
                    </twig:block>
                </twig:MainHeader>
            </div>
        </div>
        <div class="my-4 ">
            {% for employee in pagerfanta %}
                <a href="{{ path("app_employee_show" , {'id' : employee.id}) }}">
                    <twig:InformationRow itemsCenter="{{ true }}"
                                         title="{{ employee.fullName }} , {{ employee.email }}">
                        <twig:block name="value">
                            {% set days = calculate_employee_available_vacation_Days(employee) %}
                            {% if days == 0 %}
                                {{ 'employee.you_do_not_have_any_more_vacation_days' | trans }}
                            {% else %}
                                {{ days }} / {{ vacation_days_per_year }}
                            {% endif %}
                        </twig:block>
                    </twig:InformationRow>
                </a>
            {% endfor %}
        </div>
        {{ pagerfanta(pagerfanta) }}
        <div class="my-4">
            <twig:Button url="{{ path('app_home') }}" label="{{ 'action.back' | trans }}"></twig:Button>
        </div>
    </div>
{% endblock %}

{% extends 'kanban/base_content.html.twig' %}

{% block title %}{{ 'subcategory.list' | trans }}{% endblock %}

{% block content %}

    <div class="my-4">
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem
                link="{{ path('app_board_show' , {'id': boardId })}}"
                label=" {{ 'board.board' | trans() }} "
                isActive="{{ false }}"
        />
        {% if subcategory.parent %}
            {% set parents = subcategory_parent_chain(subcategory) %}
            {% for parent in parents %}
                <twig:BreadCrumbItem
                        link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : parent.id}) }}"
                        label="{{ parent.title }}"
                        isActive="{{ false }}"
                />
            {% endfor %}
        {% endif %}
        <twig:BreadCrumbItem link="{{ false }}"
                             label="{{ subcategory.title }} "
                             isActive="{{ true }}"
        />
    </div>


    <div class="my-4">


        <twig:MainHeader text=" {{ subcategory.title }}">
            <twig:block name="rightSide">
                <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">

                    <twig:Button label="{{'action.create_subcategory' | trans }}" url="{{ path('app_subcategory_create' , {'boardId': boardId , 'parentId' : subcategory.id}) }}"></twig:Button>

                    <twig:Button label="{{'action.create_task' | trans }}" url="{{ path('app_task_create' , {'boardId': boardId , 'parentId' : subcategory.id}) }}"></twig:Button>


                </div>
            </twig:block>


        </twig:MainHeader>

        <twig:Section title="{{ 'subcategory.categories' | trans }}" class="mx-4">
            <twig:block name="content">
                {% if subcategory.children|length > 0 %}
                    {% for child in subcategory.children %}
                        <a href="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : child.id}) }}">
                            <twig:Row title="{{ child.title }}" class="px-4"></twig:Row>
                        </a>
                    {% endfor %}
                {% else %}
                    <p class="px-4 text-gray-500 italic">{{ 'subcategory.no_subcategories' | trans }}</p>
                {% endif %}
            </twig:block>
        </twig:Section>


        <twig:Section title="{{ 'subcategory.tasks' | trans }}" class="mx-4">
            <twig:block name="content">
                {% if subcategory.tasks|length > 0 %}
                    {% for task in subcategory.tasks %}
                        <a href="{{ path('app_task_show' , {'boardId' : boardId, 'id' : task.id } ) }}">
                            <twig:Row title="{{ task.title }}" class="px-4"></twig:Row>
                        </a>
                    {% endfor %}
                {% else %}
                    <p class="px-4 text-gray-500 italic">{{ 'subcategory.no_tasks' | trans }}</p>
                {% endif %}
            </twig:block>
        </twig:Section>


        {% if subcategory.parent %}
            <twig:Button label="{{'action.back' | trans }}" url="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : subcategory.parent.id}) }}"></twig:Button>
        {% else %}
            <twig:Button label="{{'action.back' | trans }}" url="{{ path('app_board_show' , {'id': boardId }) }}"></twig:Button>
        {% endif %}

    </div>
{% endblock %}

{% extends 'dashboard/base_content.html.twig' %}

{% block title %}{{ 'subcategory.list' | trans }}{% endblock %}

{% block content %}

    <div class="my-4">
        <twig:BreadCrumbHome/>
        {% if boardId %}
            <twig:BreadCrumbItem
                    link="{{ path('app_board_show' , {'id': boardId }) }}"
                    label=" {{ 'board.board' | trans() }} "
                    isActive="{{ false }}"
            />
            {% if task.subcategory %}

                {% if task.subcategory.parent %}
                    {% set parents = subcategory_parent_chain(task.subcategory) %}
                    {% for parent in parents %}
                        <twig:BreadCrumbItem
                                link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : parent.id}) }}"
                                label="{{ parent.title }}"
                                isActive="{{ false }}"
                        />
                    {% endfor %}
                {% endif %}
                <twig:BreadCrumbItem
                        link="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : task.subcategory.id}) }}"
                        label="{{ task.subcategory.title }}"
                        isActive="{{ false }}"
                />
            {% endif %}
        {% endif %}

        <twig:BreadCrumbItem link="{{ false }}"
                             label="{{ task.title }} "
                             isActive="{{ true }}"
        />
    </div>


    <div class="my-4">

        <twig:MainHeader text=" {{ task.title }}" description="{{ task.description }}">
            <twig:block name="rightSide">

                <div class="flex flex-col justify-end space-y-2 sm:space-y-0 sm:space-x-2 sm:flex-row">
                    <twig:Button label="{{'action.edit' | trans }}" url="{{ path('app_task_edit' , {'boardId': boardId  , 'id' : task.id}) }}"></twig:Button>

                    <twig:Button label="{{'action.delete' | trans }}" url="{{ path('app_task_delete' , {'boardId': boardId , 'id' : task.id}) }}"></twig:Button>
                </div>



            </twig:block>
        </twig:MainHeader>

        <twig:Section title="{{ 'task.details' | trans }}" class="mx-4">
            <twig:block name="content">

                <twig:InformationRow title="{{ 'task.priority' | trans }}">
                    <twig:block name="value">{{ task.taskPriority.getTranslationKey | trans }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.status' | trans }}">
                    <twig:block name="value">{{ task.taskStatus.getTranslationKey | trans }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.deadline' | trans }}">
                    <twig:block name="value">{{ task.deadline ? task.deadline|date('Y-m-d, H:i') : '-' }}</twig:block>
                </twig:InformationRow>

                <twig:InformationRow title="{{ 'task.scheduled_for_date' | trans }}">
                    <twig:block name="value">{{ task.scheduledForDate ? task.scheduledForDate|date('Y-m-d, H:i') : '-' }}</twig:block>
                </twig:InformationRow>

                <twig:Section >
                    <twig:block name="content">


                        <div class="flex-grow">
                            <twig:InformationRow title="{{ 'task.estimate' | trans }}">
                                <twig:block name="value">
                                    <div class="flex justify-between">
                                        <div class="">

                                            {% set estimate = minutes_to_estimate_parts(task.approximateEstimate) %}

                                            {% if estimate[0] > 0 or estimate[1] > 0 %}
                                                {{ estimate[0] }}h {{ estimate[1] }}min
                                            {% else %}
                                                0 {{ 'estimate.minutes' | trans }}
                                            {% endif %}



                                        </div>
                                        <div class="">

                                            <div class=" flex flex-grow-0 flex-row  w-12">
                                                <div class="flex justify-center items-center  border-primary">
                                                    <a href="{{ path('app_task_estimate', { 'id': task.id , 'boardId': boardId }) }}">
                                                        <svg width="22" height="23" viewBox="0 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M13 1V5" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M8 3L10 6" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M6 9H9" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M1 22L13 9" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M13 17V13" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M19 15L16 12" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M21 9H18" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                            <path d="M19 3L16 6" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>


                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </twig:block>
                            </twig:InformationRow>
                        </div>

                    </twig:block>
                </twig:Section>


            </twig:block>
        </twig:Section>

        {{ dump(task) }}

        {% if boardId %}
            {% if subcategory %}
                <twig:Button label="{{ 'action.back' | trans }}"
                             url="{{ path('app_subcategory_show' , {'boardId': boardId , 'id' : subcategory.id}) }}"></twig:Button>
            {% else %}
                <twig:Button label="{{ 'action.back' | trans }}"
                             url="{{ path('app_board_show' , {'id': boardId }) }}"></twig:Button>
            {% endif %}
        {% else %}
            <twig:Button label="{{ 'action.back' | trans }}" url="{{ path('app_home') }}"></twig:Button>
        {% endif %}

    </div>
{% endblock %}

{% extends 'base_public.html.twig' %}
{% form_theme registrationForm 'form_div_layout.html.twig' %}

{% block title %}{{ 'security.sign_up' | trans }}{% endblock %}

{% block content %}

    <h1 class="my-4 text-2xl">{{ 'security.please_sign_up' | trans }}</h1>

    {{ form_start(registrationForm) }}

    {# Загальні помилки форми #}
    {% if registrationForm.vars.errors|length > 0 %}
        <div class="text-red-500 mb-4 text-sm">
            {{ form_errors(registrationForm) }}
        </div>
    {% endif %}

    {# Email #}
    <div class="relative z-0 w-full mb-5 group">
        {{ form_widget(registrationForm.email, {
            'attr': {
                'placeholder': ' ',
                'class': 'block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:border-gray-600 focus:outline-none focus:ring-0',
                'autocomplete': 'email'
            }
        }) }}
        <label for="{{ registrationForm.email.vars.id }}"
               class="absolute text-sm text-gray-500 dark:text-gray-400 scale-75 -top-2 -z-10">
            {{ 'security.email' | trans }}
        </label>
        <div class="text-red-500 mb-4 text-sm">
        {{ form_errors(registrationForm.email) }}
            </div>
    </div>

    {# Password (first input) #}
    <div class="relative z-0 w-full mb-5 group">
        {{ form_widget(registrationForm.plainPassword.first, {
            'attr': {
                'placeholder': ' ',
                'class': 'block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:border-gray-600 focus:outline-none focus:ring-0',
                'autocomplete': 'new-password'
            },
            'label': false
        }) }}
        <label for="{{ registrationForm.plainPassword.first.vars.id }}"
               class="absolute text-sm text-gray-500 dark:text-gray-400 scale-75 -top-2 -z-10">
            {{ 'security.password' | trans }}
        </label>
        <div class="text-red-500 text-sm mt-1">
        {{ form_errors(registrationForm.plainPassword.first) }}
        </div>
    </div>

    {# Password (confirmation) #}
    <div class="relative z-0 w-full mb-5 group">
        {{ form_widget(registrationForm.plainPassword.second, {
            'attr': {
                'placeholder': ' ',
                'class': 'block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:border-gray-600 focus:outline-none focus:ring-0',
                'autocomplete': 'new-password'
            },
            'label': false
        }) }}
        <label for="{{ registrationForm.plainPassword.second.vars.id }}"
               class="absolute text-sm text-gray-500 dark:text-gray-400 scale-75 -top-2  -z-10">
            {{ 'security.repeat_password' | trans }}
        </label>
        <div class="text-red-500 text-sm mt-1">
        {{ form_errors(registrationForm.plainPassword.second) }}
        </div>
    </div>

    {# Групова помилка підтвердження паролю (наприклад, не співпадають) #}
    {% if registrationForm.plainPassword.vars.errors|length > 0 %}
        <div class="text-red-500 text-sm mt-1">
            {{ form_errors(registrationForm.plainPassword) }}
        </div>
    {% endif %}

    {# Agree to terms #}
    <div class="checkbox my-3">
        {{ form_widget(registrationForm.agreeTerms) }}
        <label for="{{ registrationForm.agreeTerms.vars.id }}">
            {{ 'security.agree_terms' | trans }}
        </label>
        <div class="text-red-500 mb-4 text-sm">
        {{ form_errors(registrationForm.agreeTerms) }}
        </div>
    </div>

    <twig:Button label="{{ 'security.sign_up' | trans }}" url="{{ false }}"></twig:Button>

    {{ form_end(registrationForm) }}

    <div class="my-4">
        <a href="{{ path('app_login') }}"
           class="text-sm underline underline-offset-4 text-gray-500">{{ 'security.already_have_account' | trans }}</a>
    </div>

{% endblock %}

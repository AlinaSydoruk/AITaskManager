{% extends 'profile.html.twig' %}

{% block title %}{{ 'task.board' | trans }}{% endblock %}

{% block content %}
        <twig:BreadCrumbHome/>
        <twig:BreadCrumbItem
                link="{{ false}}"
                label="{{  board.title }}"
                isActive="{{ true }}"
        />


    <div data-controller="kanban" class="flex space-x-4 p-6">
        {% for status, tasks in tasksByStatus %}
            <div class="flex-1 bg-gray-100 p-4 rounded shadow" data-kanban-target="column" data-status="{{ status }}">
                <h2 class="font-bold text-lg mb-4">{{ status|trans }}</h2>
                <div class="space-y-2 min-h-[200px]" data-kanban-target="taskContainer" data-status="{{ status }}">
                    {% for task in tasks %}
                        <div class="p-3 bg-white shadow rounded cursor-move"
                             data-kanban-target="task"
                             data-task-id="{{ task.id }}"
                             draggable="true">
                            {{ task.title }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>








{% endblock %}
